<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.test.controller.FormController"
        hgap="10"
        vgap="10"
        stylesheets="@styles.css">

    <children>

        <Label text="Nombre"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Correo"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCorreo"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Edad"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtEdad"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label fx:id="lblMensaje"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>

        <Button
                text="Guardar"
                onAction="#guardarEstudiante"
                GridPane.rowIndex="4"
                GridPane.columnIndex="0"/>

        <Button
                text="Volver"
                onAction="#volverLista"
                GridPane.rowIndex="4"
                GridPane.columnIndex="1"/>

    </children>

</GridPane>