<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.test.controller.ListaController"
        stylesheets="@styles.css">

    <center>

        <VBox spacing="10"
              alignment="CENTER">

            <Label text="Gestión de estudiantes"/>

            <TableView fx:id="tablaEstudiantes">

                <columns>

                    <TableColumn
                            fx:id="colId"
                            text="ID"/>

                    <TableColumn
                            fx:id="colNombre"
                            text="Nombre"/>

                    <TableColumn
                            fx:id="colCorreo"
                            text="Correo"/>

                    <TableColumn
                            fx:id="colEdad"
                            text="Edad"/>

                </columns>

            </TableView>

            <Button
                    text="Nuevo estudiante"
                    onAction="#abrirFormulario"/>

        </VBox>

    </center>

</BorderPane>